# ──────────────────────────────────────────────
# OMEGA — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and update values as needed.
# NEVER commit .env to version control.

# ── Application ──
ENVIRONMENT=development
LOG_LEVEL=INFO
AUTO_MIGRATE=true

# ── Database (async — used by FastAPI) ──
DATABASE_URL=postgresql+asyncpg://omega:omega_dev@omega-postgres:5432/omega

# ── Database (sync — used by Celery worker) ──
DATABASE_URL_SYNC=postgresql+psycopg2://omega:omega_dev@omega-postgres:5432/omega

# ── Redis ──
REDIS_URL=redis://omega-redis:6379/0

# ── CORS ──
CORS_ORIGINS=http://localhost:3000

# ── PostgreSQL Container ──
POSTGRES_USER=omega
POSTGRES_PASSWORD=omega_dev
POSTGRES_DB=omega

# ── Frontend ──
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Storage & Media ──
MEDIA_STORAGE_ROOT=/app/data

# ── Credential Vault ──
OMEGA_SECRET_ENCRYPTION_KEY=<fernet-key>

# ── Google OAuth & Publisher ──
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/publisher/accounts/youtube/callback
