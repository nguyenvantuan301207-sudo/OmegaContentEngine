# ──────────────────────────────────────────────
# OMEGA — .gitignore
# ──────────────────────────────────────────────

# ── Secrets & Environment ──
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
/secrets/omega_keyring.json

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl
.venv/
venv/
env/
.python-version
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ── Node.js ──
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Docker ──
docker-compose.override.yml

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
backend/celerybeat-schedule*
backend/data/

# ── Local DB snapshots / backups (never commit) ──
*_pre_v1_decommission.sql
*_vault_backup.sql

# ── Local Model Weights (never commit) ──
models/
backend/models/
*.onnx
*.bin

